# Copy to .env and replace every value before deployment. Never commit .env.
SECRET_KEY=replace-with-a-long-random-secret
# PostgreSQL connection string. Vercel uses Neon (or another managed PostgreSQL).
# Use sslmode=require for hosted databases. The app accepts postgres:// and
# postgresql:// URLs and rewrites them for psycopg.
DATABASE_URL=postgresql+psycopg://pub_grill:pub_grill@localhost:5432/pub_grill
BUSINESS_NAME=The Pub & Grill
CURRENCY=KES
TIMEZONE=Africa/Nairobi

# First administrator. These values are authoritative: on every start the
# matching account is created/promoted and its password is reset if it differs.
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# Production security
COOKIE_SECURE=false
TRUSTED_HOSTS=localhost,127.0.0.1
REALTIME_ENABLED=true
AUTO_CREATE_TABLES=true
