# Copy to .env and replace every value before deployment.
SECRET_KEY=replace-with-a-long-random-secret
# PostgreSQL connection string. Create the database/user before starting the app.
# Docker Compose uses these same names; change POSTGRES_PORT if 5432 is already in use.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://pub_grill:pub_grill@localhost:5432/pub_grill
BUSINESS_NAME=The Pub & Grill
CURRENCY=KES
TIMEZONE=Africa/Nairobi
# Optional: set these only to create the first administrator during setup.
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
